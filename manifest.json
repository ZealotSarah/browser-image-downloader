{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "微博和 Instagram 图片视频下载",
  "version": "0.3.0",
  "description": "右键下载微博和 Instagram 帖子的图片、最高规格完整视频，并按作者分类保存。",
  "permissions": ["contextMenus", "downloads", "storage", "offscreen", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["https://weibo.com/*", "https://www.weibo.com/*", "https://video.weibo.com/*", "https://*.weibocdn.com/*", "https://*.sinaimg.cn/*", "https://www.instagram.com/*", "https://*.cdninstagram.com/*", "https://*.fbcdn.net/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "图片视频下载" },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://weibo.com/*", "https://www.weibo.com/*"],
      "js": ["lib.js", "video-lib.js", "content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["instagram-lib.js", "video-lib.js", "instagram.js"],
      "run_at": "document_start"
    }
  ]
}
