{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "微博、Instagram 和 X 图片视频下载",
  "version": "0.4.6",
  "description": "一个右键入口自动识别并下载微博、Instagram 和 X 帖子的图片及最高规格完整视频。",
  "permissions": ["contextMenus", "downloads", "storage", "offscreen", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["https://weibo.com/*", "https://www.weibo.com/*", "https://video.weibo.com/*", "https://*.weibocdn.com/*", "https://*.sinaimg.cn/*", "https://www.instagram.com/*", "https://*.cdninstagram.com/*", "https://*.fbcdn.net/*", "https://x.com/*", "https://www.x.com/*", "https://twitter.com/*", "https://www.twitter.com/*", "https://pbs.twimg.com/*", "https://video.twimg.com/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "图片视频下载" },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://weibo.com/*", "https://www.weibo.com/*"],
      "js": ["lib.js", "video-lib.js", "content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["instagram-lib.js", "video-lib.js", "instagram.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://x.com/*", "https://www.x.com/*", "https://twitter.com/*", "https://www.twitter.com/*"],
      "js": ["video-lib.js", "x-lib.js", "x-capture.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://x.com/*", "https://www.x.com/*", "https://twitter.com/*", "https://www.twitter.com/*"],
      "js": ["video-lib.js", "x-lib.js", "x.js"],
      "run_at": "document_start"
    }
  ]
}
